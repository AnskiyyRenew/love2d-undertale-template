{
    "Lua.diagnostics.globals": [
        "love"
    ],
    "Lua.diagnostics.disable": [
        "deprecated",
        "undefined-doc-name",
        "need-check-nil",
        "param-type-mismatch",
        "missing-fields"
    ],
    "Lua.completion.autoRequire": false,
    "Lua.runtime.special": {
        "ImportFile": "require"
    },
}